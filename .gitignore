# ===============================
# Dependencies
# ===============================
node_modules/
jspm_packages/

# ===============================
# Environment Variables & Secrets
# ===============================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Firebase service-account private keys — these are send credentials for the
# whole project, they belong in env vars, never in the tree.
*firebase-adminsdk*.json
**/serviceAccountKey.json
backend/secrets/

# ===============================
# User Uploads (server-local image storage)
# ===============================
# These are user data, not build output. The directory lives inside the git tree, so
# deploy.sh's `git reset --hard` must never gain -d and never be paired with `git clean`
# -- either would delete every uploaded image on the server.
backend/uploads/*
!backend/uploads/.gitkeep
backend/migration-failures.json


PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/offerly
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173

ENABLE_REQUEST_LOGS=false
LOG_REQUEST_BODY=false

# Image uploads are stored on this server's own disk, not a CDN.
# UPLOAD_DIR is relative to backend/ (or an absolute path).
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Origin prepended to stored image URLs. In production this must include the /api
# prefix that nginx strips, e.g. https://getofferly.in/api
PUBLIC_UPLOAD_BASE_URL=http://localhost:5000

DEFAULT_CUSTOMER_DEV_NUMBERS=9999999991,9999999992,9876543210,9999999999
DEFAULT_MERCHANT_DEV_NUMBERS=8888888881,8888888882,9876543210,9999999999
DEFAULT_DEV_OTP=123456

SMSINDIAHUB_API_KEY=
SMSINDIAHUB_SENDER_ID=SMSHUB
SMSINDIAHUB_MESSAGE_TEMPLATE=Welcome to the Styling With Muskan powered by SMSINDIAHUB. Your OTP for registration is {otp}

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Cloud Messaging (push notifications).
# Optional — with neither var set the server boots fine and push is disabled.
# Supply ONE of:
#   FIREBASE_SERVICE_ACCOUNT_JSON  raw JSON, or base64 of it (preferred: the
#                                  private key's \n newlines don't survive .env,
#                                  PM2 or Vercel env transport as raw JSON)
#   FIREBASE_SERVICE_ACCOUNT_PATH  path to the downloaded .json, relative to backend/
# Generate at: Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

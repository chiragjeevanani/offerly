# No /api prefix: Express mounts its routes at the root (app.js: app.use("/auth"...)).
# The /api you see in production URLs is nginx's, and nginx strips it before
# the request reaches Node — so hitting :5000/api/... locally is a 404.
VITE_API_URL=http://localhost:5000
VITE_USE_MOCK_DATA=false

# Firebase Cloud Messaging (push notifications).
# All of these are public client identifiers — they ship in the JS bundle and
# authorise nothing on their own. Overriding them lets a staging build point at
# a different Firebase project; the app falls back to these same values.
# MUST match the hardcoded config in public/firebase-messaging-sw.js.
VITE_FIREBASE_API_KEY=AIzaSyC-s8HtcGjJcJhnwaSxlNNAKZy3VIVieCI
VITE_FIREBASE_AUTH_DOMAIN=offerly-b2e1a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=offerly-b2e1a
VITE_FIREBASE_STORAGE_BUCKET=offerly-b2e1a.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=246962620294
VITE_FIREBASE_APP_ID=1:246962620294:web:88de04f286f515a56c0e07
VITE_FIREBASE_MEASUREMENT_ID=G-YD65E82PVD
VITE_FIREBASE_VAPID_KEY=BLJY-BULubJXm7OtsW4wKrTWqv4Z_ocOMh7hf7TXEFdXCY5DJZaehHpNOsWyelZnlMVVW4rPmBudL5e1Kmx2dvo
